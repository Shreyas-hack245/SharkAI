# none (default), openai, or ollama
SHARKAI_AI_PROVIDER=none
# OpenAI-compatible endpoint base, e.g. https://api.openai.com/v1 or your compatible gateway
SHARKAI_AI_BASE_URL=https://api.openai.com/v1
SHARKAI_AI_API_KEY=
SHARKAI_AI_MODEL=gpt-4o-mini
# For Ollama: SHARKAI_AI_PROVIDER=ollama, SHARKAI_AI_BASE_URL=http://localhost:11434, SHARKAI_AI_MODEL=llama3.2
SHARKAI_MAX_UPLOAD_MB=50
# Optional absolute path for private capture storage
# SHARKAI_STORAGE=/path/to/private/sharkai-storage
