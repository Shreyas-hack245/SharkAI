# Server and storage
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./data/sharkai.db
MAX_UPLOAD_SIZE_MB=500
ANALYSIS_TIMEOUT_SECONDS=600
TSHARK_PATH=tshark
CORS_ORIGINS=http://localhost:5173

# AI provider: openai, ollama, or custom OpenAI-compatible endpoint
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=llama3.2
AI_MAX_TOKENS=4096
