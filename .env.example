# SharkAI Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database (SQLite default, PostgreSQL optional)
DATABASE_URL=sqlite+aiosqlite:///./data/sharkai.db

# Upload limits
MAX_UPLOAD_SIZE_MB=500
MAX_PCAP_SIZE_MB=500

# Analysis
TSHARK_PATH=tshark
ANALYSIS_TIMEOUT_SECONDS=600
TEMP_DIR=./data/temp

# AI Provider: openai | ollama | custom
AI_PROVIDER=ollama
AI_MODEL=llama3.2
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2

# OpenAI (when AI_PROVIDER=openai)
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...

# Security
ALLOWED_EXTENSIONS=.pcap,.pcapng,.cap
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
